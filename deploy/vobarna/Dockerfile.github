FROM node:24-alpine@sha256:116b800c3754b440ee0aa3ed2f20f5bf3d99a554bfd9adeea09ea8017f6e85f5
RUN apk add --no-cache python3 py3-pillow tzdata
WORKDIR /app
ARG SOURCE_COMMIT=unknown
ENV NODE_ENV=production PORT=8787 PUBLICATION_ROOT=/app/.site PUBLIC_ORIGIN=https://vobarna.com VOBARNA_INPUT_ROOT=/incoming SOURCE_COMMIT=$SOURCE_COMMIT
COPY --chown=node:node scripts/ ./scripts/
COPY --chown=node:node src/public-routing.mjs src/date-listings.mjs src/vobarna-server.mjs src/smart-search.mjs src/geocode.mjs ./src/
COPY --chown=node:node static/ ./static/
COPY --chown=node:node data/ ./data/
COPY --chown=node:node docs/cinema-dossiers.json docs/auditoriums.json docs/cinema-practical-info.json ./docs/
COPY --chown=node:node barcelona-mascot-point-right-brow-refined.webp barcelona-mascot-poke.webp ./
RUN mkdir -p /app/.site /app/static/preview-data && chown -R node:node /app
USER node
EXPOSE 8787
HEALTHCHECK --interval=15s --timeout=5s --start-period=180s --retries=3 CMD node -e "fetch('http://127.0.0.1:8787/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["python3", "scripts/serve_deployed_site.py"]
