// Session masking in destination.mjs applies across every triggering event.
if (empty(event.distinct_id) or empty(event.properties.$session_id)) { return; }
if (event.properties.visitor_alert_version != 1 or event.properties.internal_user = true) { return; }
if (event.properties.$host not in ('vobarna.com', 'www.vobarna.com')) { return; }
let stats := [0, null, null, 0, 0, 0, null, 0];
let history_available := event.properties.visitor_identity_persisted = true;
if (history_available) {
 let history := fetch('https://us.posthog.com/api/projects/751818/query/', {
  'method': 'POST', 'headers': {'Content-Type': 'application/json'},
  'secret_headers_input': 'posthog_headers',
  'body': {'query': {'kind': 'HogQLQuery', 'query': inputs.query,
  'values': {'visitor': event.distinct_id, 'session': event.properties.$session_id,
  'at': event.timestamp}}, 'refresh': 'force_blocking'}
 });
 if (history.status != 200 or empty(history.body?.results)
     or length(history.body.results[1]) != 8 or history.body.results[1][1] = null) {
  history_available := false;
  print('History unavailable; continuing with unclassified session alert', history.status);
 } else { stats := history.body.results[1]; }
}
let returning := stats[1] > 0;
let payload := inputs.body;
payload.rich_message.blocks[1].text.text := if(event.properties.notification_test, 'TEST — ', '')
 || if(not history_available, 'VO Barna visitor session', if(returning, 'Returning VO Barna visitor', 'New VO Barna visitor'));
let classification := if(not history_available, 'unclassified', if(returning, 'returning', 'new'));
fn duration(seconds) {
 if (empty(seconds) or seconds < 1) { return '0m (no measurable span)'; }
 let minutes := floor(seconds / 60);
 if (minutes < 1) { return toString(round(seconds)) || 's'; }
 return if(minutes >= 60, toString(floor(minutes / 60)) || 'h ', '') || toString(minutes % 60) || 'm';
}
fn row(label, value) { return {'type': 'paragraph', 'text': [{'type': 'bold', 'text': label || ': '}, value]}; }

if (returning) {
let details := [
 row('Recorded visits', toString(stats[1] + 1) || ' including this visit'),
 row('Recent visits', toString(stats[4] + 1) || ' in 7 days · ' || toString(stats[5] + 1) || ' in 30 days'),
 row('First recorded visit', replaceAll(substring(toString(stats[2]), 1, 16), 'T', ' ') || ' UTC'),
 row('Previous visit', replaceAll(substring(toString(stats[3]), 1, 16), 'T', ' ') || ' UTC'),
 row('Past session time', duration(stats[6]) || ' total · ' || duration(stats[7]) || ' average'),
 row('Past pageviews', toString(stats[8])),
 {'type': 'paragraph', 'text': 'Time is elapsed between recorded events, may include idle time, and excludes this visit. Counts cover recorded history for this browser identity.'}
];
let blocks := [payload.rich_message.blocks[1]];
for (let i := 1; i <= length(details); i := i + 1) { blocks := arrayPushBack(blocks, details[i]); }
for (let i := 2; i <= length(payload.rich_message.blocks); i := i + 1) { blocks := arrayPushBack(blocks, payload.rich_message.blocks[i]); }
payload.rich_message.blocks := blocks;

}

if (not history_available) {
 payload.rich_message.blocks := arrayPushBack(payload.rich_message.blocks,
  row('Visit history', if(event.properties.visitor_identity_persisted = true, 'Temporarily unavailable; this session is not classified as new or returning.', 'Browser storage is unavailable; this session is not classified as new or returning.')));
}
if (inputs.dry_run) { print('VISITOR_PREVIEW', classification, payload); return; }
// Each fetch is durably queued by PostHog, with native backoff/retries.
// Resume this invocation, not a new source event blocked by the session mask.
// One history fetch + at most four delivery fetches respects the five-fetch limit.
for (let delivery_attempt := 1; delivery_attempt <= 4; delivery_attempt := delivery_attempt + 1) {
 let res := fetch(inputs.telegram_url, {'method': 'POST', 'headers': {'Content-Type': 'application/json'}, 'body': payload});
 if (res.status >= 200 and res.status < 300 and res.body?.ok = true
     and not empty(res.body?.result?.message_id)) {
  print('Telegram delivery', classification, true, res.body.result.message_id, res.body.result.message_thread_id);
  print('DELIVERY_RECEIPT', event.uuid, delivery_attempt, res.body.result.message_id);
  return;
 }
 // Do not repeatedly submit invalid credentials, forbidden chats or malformed payloads.
 let retryable := res.status = 408 or res.status = 429 or res.status >= 500
  or res.body?.error_code = 429 or res.body?.error_code >= 500;
 if (not retryable or delivery_attempt = 4) {
  print('DELIVERY_FAILED', event.uuid, delivery_attempt, res.status);
  throw Error('Telegram delivery failed; HTTP ' || toString(res.status));
 }
 print('DELIVERY_RETRY', event.uuid, delivery_attempt, res.status);
}
